NODE_ENV=development
PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/calltrack
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:8081
# sim uses Android Telecom evidence where available; business outcomes are saved separately.
# demo only simulates events and never opens the phone dialer.
CALL_MODE=sim
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=CallTrack Workspace
TRUST_PROXY_HOPS=0
RECORDING_ENCRYPTION_KEY=
RECORDING_DIRECTORY=
WEB_DIRECTORY=
